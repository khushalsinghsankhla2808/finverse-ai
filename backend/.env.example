# ════════════════════════════════════════
# SERVER
# ════════════════════════════════════════
# Port the Express server listens on
PORT=5000

# Set to 'production' on Render/Railway, 'development' locally
NODE_ENV=development

# ════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
# IMPORTANT: Whitelist 0.0.0.0/0 in Atlas Network Access for Render
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/FinVerse

# ════════════════════════════════════════
# JWT AUTHENTICATION
# ════════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Generate a DIFFERENT secret from JWT_SECRET
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ════════════════════════════════════════
# REDIS CACHE
# ════════════════════════════════════════
# Local development: redis://localhost:6379
# Production: Use Upstash free tier at https://upstash.com
REDIS_URL=redis://localhost:6379

# ════════════════════════════════════════
# GOOGLE GEMINI AI
# ════════════════════════════════════════
# Get free API key from: https://aistudio.google.com
# Without this key the AI runs in demo/fallback mode
GEMINI_API_KEY=

# ════════════════════════════════════════
# CLOUDINARY (Report Storage)
# ════════════════════════════════════════
# Get from: https://cloudinary.com → Dashboard
# Without these, reports fall back to local file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ════════════════════════════════════════
# EMAIL (Optional)
# ════════════════════════════════════════
# For Gmail: use an App Password, not your real password
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ════════════════════════════════════════
# CORS
# ════════════════════════════════════════
# Local: http://localhost:5173
# Production: your Vercel URL e.g. https://finverse-ai.vercel.app
CLIENT_URL=http://localhost:5173

# ════════════════════════════════════════
# RATE LIMITING (Optional — defaults shown)
# ════════════════════════════════════════
# RL_AUTH_IP_WINDOW_MS=900000
# RL_AUTH_IP_MAX=10
# RL_AUTH_ACCOUNT_WINDOW_MS=1800000
# RL_AUTH_ACCOUNT_MAX_FAILED=5
# RL_AUTH_BACKOFF_BASE_MS=1000
# RL_AUTH_BACKOFF_CEILING_MS=128000
# RL_PUBLIC_WINDOW_MS=60000
# RL_PUBLIC_MAX=60
# RL_PUBLIC_BURST=10
# RL_AUTH_USER_WINDOW_MS=60000
# RL_AUTH_USER_MAX=200
# RL_GLOBAL_WINDOW_MS=900000
# RL_GLOBAL_MAX=500

# ════════════════════════════════════════
# FIREBASE AUTHENTICATION (Phase 2 & 3)
# ════════════════════════════════════════
# Get credentials from: Firebase Console → Project Settings → Service Accounts
# Generate a new private key and paste details below
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

