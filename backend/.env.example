# FinVerse Backend — Environment Variables
#
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to version control.
#
# All variables are validated at startup by src/config/env.ts
# The server will refuse to start if required variables are missing.

# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# MongoDB connection string (Atlas SRV or local)
MONGODB_URI=

# ─── JWT Authentication ───────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Refresh token secret (separate from access token secret)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (optional, falls back to in-memory) ───────────
REDIS_URL=redis://localhost:6379

# ─── Cloudinary (file storage) ────────────────────────────
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google Gemini AI ─────────────────────────────────────
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Email (SMTP) ────────────────────────────────────────
# For Gmail: use App Passwords (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─── Frontend URL (CORS allowlist) ───────────────────────
CLIENT_URL=http://localhost:5173

# ─── Rate Limiting (all optional, defaults in config/rateLimits.ts) ──
# Auth tier — per-IP
# RL_AUTH_IP_WINDOW_MS=900000
# RL_AUTH_IP_MAX=10
# Auth tier — per-account
# RL_AUTH_ACCOUNT_WINDOW_MS=1800000
# RL_AUTH_ACCOUNT_MAX_FAILED=5
# Auth tier — exponential backoff
# RL_AUTH_BACKOFF_BASE_MS=1000
# RL_AUTH_BACKOFF_CEILING_MS=128000
# RL_AUTH_BACKOFF_MULTIPLIER=2
# Public tier
# RL_PUBLIC_WINDOW_MS=60000
# RL_PUBLIC_MAX=60
# RL_PUBLIC_BURST=10
# Authenticated tier
# RL_AUTH_USER_WINDOW_MS=60000
# RL_AUTH_USER_MAX=200
# Global safety net
# RL_GLOBAL_WINDOW_MS=900000
# RL_GLOBAL_MAX=500
